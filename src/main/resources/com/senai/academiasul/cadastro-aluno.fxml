<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="1400.0" spacing="12" styleClass="tela-cadastro" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.academiasul.CadastroAlunoController">

    <padding><Insets bottom="25" left="30" right="30" top="25" /></padding>
   <ImageView fitHeight="150.0" fitWidth="222.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@imagens/hellokittyeacademia-removebg-preview.png" />
      </image>
   </ImageView>

    <Label styleClass="titulo-menu" text="Cadastro de aluno" />

    <TextField fx:id="campoNome" maxWidth="350" promptText="Nome completo" />
    <TextField fx:id="campoCpf" maxWidth="350" promptText="CPF" />
    <TextField fx:id="campoMatricula" maxWidth="350" promptText="Matrícula" />
    <ComboBox fx:id="comboPlano" maxWidth="350" prefWidth="350" promptText="Selecione o tipo de plano" />

    <Button maxWidth="350" onAction="#cadastrarAluno" text="Cadastrar aluno" />
    <Label fx:id="mensagem" styleClass="mensagem" wrapText="true" />
</VBox>
